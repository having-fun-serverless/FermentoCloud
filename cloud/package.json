{
  "name": "cloud",
  "version": "0.1.0",
  "type": "module",
  "blocksTemplate": "default",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "aws-blocks"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test aws-blocks/**/*.test.ts",
    "test:e2e": "tsx --test e2e/readings.e2e.test.ts",
    "sandbox": "tsx aws-blocks/scripts/sandbox.ts",
    "sandbox:destroy": "tsx -C cdk aws-blocks/scripts/sandbox-destroy.ts",
    "sandbox:console": "tsx aws-blocks/scripts/console.ts",
    "cleanup": "tsx aws-blocks/scripts/cleanup.ts",
    "deploy": "tsx aws-blocks/scripts/deploy.ts",
    "destroy": "tsx aws-blocks/scripts/destroy.ts"
  },
  "dependencies": {
    "@aws-blocks/blocks": "*",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-lambda-powertools/event-handler": "^2.33.1",
    "@aws-sdk/credential-provider-node": "^3.972.64",
    "@smithy/protocol-http": "^5.5.7",
    "@smithy/signature-v4": "^5.6.3",
    "aws-lambda": "^1.0.7",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^20.0.0",
    "aws-cdk-lib": "^2.257.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.27.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^6.4.3"
  },
  "blocksTemplateVersion": "0.1.0"
}
